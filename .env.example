# rtsp-streaming .env.example — 예시 값 (git 포함). 복사해 .env 를 만들고 실제 값을 채운다.

# ── 포트 (add-cto 자동 할당, PORT.md) ──
# 실제 포트 = 기준 + PORT_OFFSET — backend 8000, frontend 5173
BACKEND_PORT=
FRONTEND_PORT=

# ── mediamtx (이 빌드 전용 인스턴스) ──
# 실제 포트 = 기준 + PORT_OFFSET — API 9997, RTSP 8554, WebRTC 8889, ICE UDP 8189
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_API_PORT=
MEDIAMTX_RTSP_PORT=
MEDIAMTX_WEBRTC_PORT=
MEDIAMTX_ICE_UDP_PORT=
# 브라우저가 WebRTC 로 접속할 LAN·공인 IP
MEDIAMTX_WEBRTC_HOST=
# 계정 — backend = 제어·송출, viewer = 보기 전용 (빌드마다 고유 비번)
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rtsp_streaming
MEDIAMTX_VIEWER_PASS=
